#!/bin/bash
cd "${BIKE_VIEW_HOME:-$(dirname "$0")}"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

OS="$(uname -s)"

is_running() {
  pgrep -f 'uvicorn app.main' > /dev/null 2>&1
}

# Primary LAN IPv4 (the address other devices on this network can reach).
# Uses the default-route interface so it works on Wi-Fi or Ethernet.
# macOS uses route/ipconfig; Linux uses iproute2 (ip route / ip addr).
lan_ip() {
  local iface
  if [ "$OS" = "Darwin" ]; then
    iface=$(route -n get default 2>/dev/null | awk '/interface:/{print $2}')
    if [ -n "$iface" ]; then
      ipconfig getifaddr "$iface" 2>/dev/null && return
    fi
    ipconfig getifaddr en0 2>/dev/null
  else
    # Handles both "default via X dev Y" and "default dev Y" forms.
    iface=$(ip route 2>/dev/null | awk '/^default/{for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit }}')
    if [ -n "$iface" ]; then
      ip -4 -o addr show dev "$iface" 2>/dev/null | awk '/inet /{print $4}' | cut -d/ -f1 && return
    fi
    hostname -I 2>/dev/null | awk '{print $1}'
  fi
}

show_status() {
  if is_running; then
    echo -e "Status: ${GREEN}● running${NC} at http://127.0.0.1:8000"
    local ip
    ip=$(lan_ip)
    if [ -n "$ip" ]; then
      echo -e "Network: ${GREEN}http://${ip}:8000${NC} (other devices on this network)"
    fi
  else
    echo -e "Status: ${RED}● stopped${NC}"
  fi
}

cmd_start() {
  if is_running; then
    echo -e "${YELLOW}Server is already running.${NC}"
    return
  fi
  echo -n "Starting..."
  # 0.0.0.0 so the app is reachable from other devices on the network.
  nohup uv run uvicorn app.main:app --host 0.0.0.0 --port 8000 > /tmp/bikeview.log 2>&1 &
  sleep 2
  if is_running; then
    echo -e " ${GREEN}done${NC}"
    echo -e "Open ${GREEN}http://127.0.0.1:8000${NC}"
    local ip
    ip=$(lan_ip)
    if [ -n "$ip" ]; then
      echo -e "From other devices: ${GREEN}http://${ip}:8000${NC}"
    fi
  else
    echo -e " ${RED}failed${NC}"
    echo "Check /tmp/bikeview.log for errors"
  fi
}

cmd_stop() {
  if ! is_running; then
    echo -e "${YELLOW}Server is not running.${NC}"
    return
  fi
  echo -n "Stopping..."
  pkill -f 'uvicorn app.main' 2>/dev/null
  sleep 0.5
  echo -e " ${GREEN}done${NC}"
}

cmd_restart() {
  cmd_stop
  cmd_start
}

cmd_open() {
  if is_running; then
    local url="http://127.0.0.1:8000"
    if [ "$OS" = "Darwin" ]; then
      open "$url"
    elif command -v xdg-open > /dev/null 2>&1; then
      xdg-open "$url"
    else
      echo -e "Open ${GREEN}$url${NC} in your browser"
    fi
  else
    echo -e "${RED}Server is not running. Start it first.${NC}"
  fi
}

while true; do
  echo ""
  show_status
  echo ""
  echo "s) start   p) stop   r) restart   o) open   q) quit"
  read -p "> " choice
  echo ""

  case "$choice" in
    s|start)   cmd_start ;;
    p|stop)    cmd_stop ;;
    r|restart) cmd_restart ;;
    o|open)    cmd_open ;;
    q|quit)    echo "Bye!"; exit 0 ;;
    *)         echo "Invalid choice" ;;
  esac
done
