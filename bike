#!/bin/bash
cd "${BIKE_VIEW_HOME:-$(dirname "$0")}"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

is_running() {
  pgrep -f 'uvicorn app.main' > /dev/null 2>&1
}

show_status() {
  if is_running; then
    echo -e "Status: ${GREEN}● running${NC} at http://127.0.0.1:8000"
  else
    echo -e "Status: ${RED}● stopped${NC}"
  fi
}

cmd_start() {
  if is_running; then
    echo -e "${YELLOW}Server is already running.${NC}"
    return
  fi
  echo -n "Starting..."
  nohup uv run uvicorn app.main:app --host 127.0.0.1 --port 8000 > /tmp/bikeview.log 2>&1 &
  sleep 2
  if is_running; then
    echo -e " ${GREEN}done${NC}"
    echo -e "Open ${GREEN}http://127.0.0.1:8000${NC}"
  else
    echo -e " ${RED}failed${NC}"
    echo "Check /tmp/bikeview.log for errors"
  fi
}

cmd_stop() {
  if ! is_running; then
    echo -e "${YELLOW}Server is not running.${NC}"
    return
  fi
  echo -n "Stopping..."
  pkill -f 'uvicorn app.main' 2>/dev/null
  sleep 0.5
  echo -e " ${GREEN}done${NC}"
}

cmd_restart() {
  cmd_stop
  cmd_start
}

cmd_open() {
  if is_running; then
    open http://127.0.0.1:8000
  else
    echo -e "${RED}Server is not running. Start it first.${NC}"
  fi
}

while true; do
  echo ""
  show_status
  echo ""
  echo "s) start   p) stop   r) restart   o) open   q) quit"
  read -p "> " choice
  echo ""

  case "$choice" in
    s|start)   cmd_start ;;
    p|stop)    cmd_stop ;;
    r|restart) cmd_restart ;;
    o|open)    cmd_open ;;
    q|quit)    echo "Bye!"; exit 0 ;;
    *)         echo "Invalid choice" ;;
  esac
done
