{% extends "base.html.j2" %}

{% block content %}
<a
  href="{{ '/' if mode == 'create' else '/bikes/' ~ bike.id }}"
  class="back-link"
>{{ 'Back to all bikes' if mode == 'create' else 'Back to bike' }}</a>

<div class="bike-form">
  <h1>{{ 'Add New Bike' if mode == 'create' else 'Edit Bike' }}</h1>

  <form id="bike-form">
    <!-- Name -->
    <div class="form-field">
      <label for="name">Name *</label>
      <input
        type="text" id="name" name="name" required
        value="{{ bike.name if bike else '' }}"
      >
    </div>

    <!-- Description -->
    <div class="form-field">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="3">{{ bike.description if bike else '' }}</textarea>
    </div>

    <!-- Full Story -->
    <div class="form-field">
      <label for="full_story">Full Story</label>
      <textarea id="full_story" name="full_story" rows="10">{{ bike.full_story if bike else '' }}</textarea>
    </div>

    <!-- Status -->
    <div class="form-field">
      <label>Status</label>
      <div class="radio-group">
        <label>
          <input type="radio" name="status" value="active"
            {{ 'checked' if (bike and bike.status == 'active') or mode == 'create' else '' }}
          > Active
        </label>
        <label>
          <input type="radio" name="status" value="former"
            {{ 'checked' if bike and bike.status == 'former' else '' }}
          > Former
        </label>
      </div>
    </div>

    <!-- Dates -->
    <div class="form-field">
      <label for="acquired_on">Acquired On</label>
      <input
        type="date" id="acquired_on" name="acquired_on"
        value="{{ bike.acquired_on if bike else '' }}"
      >
    </div>

    <div class="form-field">
      <label for="retired_on">Retired On</label>
      <input
        type="date" id="retired_on" name="retired_on"
        value="{{ bike.retired_on if bike else '' }}"
      >
    </div>

    <!-- Pill Selector -->
    <div class="form-field">
      <label>Pills</label>
      <div class="pill-selector">
        {% for pill in all_pills %}
          {% set pill_ids = bike_pills | map(attribute='id') | list if bike_pills else [] %}
          <label class="pill-option" style="--pill-color: {{ pill.color }}">
            <input type="checkbox" name="pill_ids" value="{{ pill.id }}"
              {{ 'checked' if pill.id in pill_ids else '' }}
            >
            {{ pill.label }}
          </label>
        {% endfor %}
      </div>
    </div>

    <!-- Images -->
    <div class="form-field">
      <label>Images</label>
      {% if mode == 'edit' %}
        <div class="upload-zone" id="upload-zone">
          <p>Drag &amp; drop images here, or click to browse</p>
          <input type="file" id="image-file-input" multiple accept="image/*" hidden>
        </div>
        <div id="image-list" class="image-list" data-bike-id="{{ bike.id }}">
          {% for image in images %}
            <div
              class="image-row{{ ' is-primary' if image.is_primary }}"
              data-image-id="{{ image.id }}"
            >
              <span class="image-row__handle" draggable="true" title="Drag to reorder">&vArr;</span>
              <img
                src="/api/images/{{ bike.id }}/{{ image.thumb }}"
                alt="{{ image.original_name }}"
              >
              <button
                type="button"
                class="image-row__primary"
                data-image-id="{{ image.id }}"
                title="Make primary"
              >{{ '★' if image.is_primary else '☆' }}</button>
              <button
                type="button"
                class="image-row__delete"
                data-image-id="{{ image.id }}"
                title="Delete image"
              >&times;</button>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="upload-zone" id="upload-zone">
          <p>Drag &amp; drop images here, or click to browse</p>
          <input type="file" id="image-file-input" multiple accept="image/*" hidden>
        </div>
        <div id="image-list" class="image-list"></div>
        <p class="pill-note">The first image becomes the primary photo — drag rows to reorder before saving.</p>
      {% endif %}
    </div>

    <!-- Actions -->
    <div class="form-actions">
      <button type="submit" class="btn btn--primary">
        {{ 'Add Bike' if mode == 'create' else 'Save Changes' }}
      </button>
      <a
        href="{{ '/' if mode == 'create' else '/bikes/' ~ bike.id }}"
        class="btn btn--ghost"
      >Cancel</a>
    </div>
  </form>
</div>
{% endblock %}

{% block scripts %}
<script src="/static/js/image-upload.js"></script>
<script>
  const submitBtn = document.querySelector('#bike-form button[type="submit"]');
  let submitting = false; // guards the multi-step create flow against double-submit

  document.getElementById('bike-form').addEventListener('submit', async function(e) {
    e.preventDefault();

    const formData = new FormData(this);
    const data = {
      name: formData.get('name'),
      description: formData.get('description') || '',
      full_story: formData.get('full_story') || '',
      status: formData.get('status') || 'active',
      acquired_on: formData.get('acquired_on') || null,
      retired_on: formData.get('retired_on') || null,
    };
    const pillIds = formData.getAll('pill_ids').map(Number);

    {% if mode == 'create' %}
    if (submitting) return;
    submitting = true;
    submitBtn.disabled = true;
    try {
      const bike = await api.post('/api/bikes', data);
      // Post-create steps are best-effort: the bike exists, so alert and
      // still redirect rather than strand the user on the form (a resubmit
      // would create a duplicate bike).
      if (pillIds.length > 0) {
        try {
          await api.put('/api/bikes/' + bike.id + '/pills', { pill_ids: pillIds });
        } catch (err) {
          alert('Bike created, but pills failed to save: ' + err.message);
        }
      }
      if (window.BikeImages && window.BikeImages.hasPending()) {
        try {
          await window.BikeImages.uploadPending(bike.id);
        } catch (err) {
          alert('Bike created, but image upload failed: ' + err.message + ' (add them via Edit)');
        }
      }
      window.location.href = '/bikes/' + bike.id;
    } catch (err) {
      // Only the create POST failing leaves the user on the form.
      submitting = false;
      submitBtn.disabled = false;
      alert('Failed to create bike: ' + err.message);
    }
    {% else %}
    try {
      await api.patch('/api/bikes/{{ bike.id }}', data);
      await api.put('/api/bikes/{{ bike.id }}/pills', { pill_ids: pillIds });
      window.location.href = '/bikes/{{ bike.id }}';
    } catch (err) {
      alert('Failed to save bike: ' + err.message);
    }
    {% endif %}
  });
</script>
{% endblock %}
