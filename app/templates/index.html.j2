{% extends "base.html.j2" %}

{% block content %}
<div class="page-header">
  <h1>My Bikes</h1>
</div>

<div id="bike-grid" class="bike-grid">
  {% for bike in bikes %}
    {% include "partials/bike_card.html.j2" %}
  {% endfor %}
</div>

<p id="empty-state" class="empty-state" {% if bikes %}style="display: none;"{% endif %}>
  {% if status_filter|default('all') == "active" %}No active bikes.
  {% elif status_filter|default('all') == "former" %}No former bikes.
  {% else %}No bikes yet. <a href="/bikes/new">Add your first one</a>.{% endif %}
</p>
{% endblock %}
