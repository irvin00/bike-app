{% extends "base.html.j2" %}

{% block content %}
<div class="page-header">
  <h1>Settings / Data</h1>
  <a href="/" class="btn btn--ghost">Back to bikes</a>
</div>

<div class="settings-block">
  <h2>Export</h2>
  <p>Download everything as a <code>bike_view.json</code> file: bikes with
    their pills, images (as filenames), and maintenance records, plus the
    pill catalog. Image files live in <code>uploads/</code> — copy that
    folder alongside the JSON to keep photos in a backup.</p>
  <a href="/api/export" class="btn btn--primary">Download bike_view.json</a>
</div>

<div class="settings-block">
  <h2>Import</h2>
  <p>Restore from a <code>bike_view.json</code> export. This
    <strong>replaces all current data</strong> — existing bikes, pills,
    photos, and maintenance records are deleted first. Restored image rows
    render only when the matching files are present in <code>uploads/</code>;
    otherwise they fall back to the placeholder.</p>
  <div class="import-controls">
    <input type="file" id="import-file" accept=".json,application/json">
    <button type="button" id="import-btn" class="btn btn--danger" disabled>Import</button>
  </div>
  <p id="import-status" class="settings-status" hidden></p>
</div>
{% endblock %}

{% block scripts %}
<script src="/static/js/settings-data.js"></script>
{% endblock %}
