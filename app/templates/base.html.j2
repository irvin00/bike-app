<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bike View</title>
  <link rel="icon" type="image/jpeg" href="/static/img/favicon.jpg">
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body>
  <nav class="nav">
    <div class="container">
      <a href="/" class="nav__title">Bike View</a>
      <div class="nav__actions">
        {% if show_status_filter|default(true) %}
        <div class="status-filter">
          {% set current = status_filter|default('all') %}
          <a href="/" class="status-filter__btn{{ ' active' if current == 'all' }}">All</a>
          <a href="/?status=active" class="status-filter__btn{{ ' active' if current == 'active' }}">Active</a>
          <a href="/?status=former" class="status-filter__btn{{ ' active' if current == 'former' }}">Former</a>
        </div>
        {% endif %}
        <a href="/bikes/new" class="btn btn--primary">+ Add Bike</a>
        <a href="/pills" class="btn btn--ghost">Pills</a>
      </div>
    </div>
  </nav>

  <main class="container">
    {% block content %}{% endblock %}
  </main>

  {% include "partials/confirm_dialog.html.j2" %}

  <script src="/static/js/api.js"></script>
  <script src="/static/js/ui.js"></script>
  <script src="/static/js/confirm-dialog.js"></script>
  <script src="/static/js/inline-edit.js"></script>
  {% block scripts %}{% endblock %}
</body>
</html>
