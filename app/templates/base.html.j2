<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bike View</title>
  <link rel="icon" type="image/jpeg" href="/static/img/favicon.jpg">
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body>
  <nav class="nav">
    <div class="container">
      <a href="/" class="nav__title">Bike View</a>
      <div class="nav__actions">
        {% if show_status_filter|default(true) %}
        <div class="status-filter">
          {% set current = status_filter|default('all') %}
          <a href="/" class="status-filter__btn{{ ' active' if current == 'all' }}">All</a>
          <a href="/?status=active" class="status-filter__btn{{ ' active' if current == 'active' }}">Active</a>
          <a href="/?status=former" class="status-filter__btn{{ ' active' if current == 'former' }}">Former</a>
        </div>
        {% endif %}
        <a href="/bikes/new" class="btn btn--primary">+ Add Bike</a>
        <a href="/pills" class="btn btn--ghost">Pills</a>
        <button
          type="button"
          class="settings-open-btn"
          id="settings-open-btn"
          aria-label="Open settings"
          title="Settings"
        >
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </button>
      </div>
    </div>
  </nav>

  <main class="container">
    {% block content %}{% endblock %}
  </main>

  {% include "partials/confirm_dialog.html.j2" %}
  {% include "partials/settings_drawer.html.j2" %}

  <script src="/static/js/api.js"></script>
  <script src="/static/js/ui.js"></script>
  <script src="/static/js/image-fallback.js"></script>
  <script src="/static/js/confirm-dialog.js"></script>
  <script src="/static/js/settings-drawer.js"></script>
  <script src="/static/js/inline-edit.js"></script>
  {% block scripts %}{% endblock %}
</body>
</html>
