<dialog id="settings-drawer" class="settings-drawer">
  <div class="settings-drawer__header">
    <h2 class="settings-drawer__title">Settings</h2>
    <button
      type="button"
      class="settings-drawer__close"
      id="settings-close-btn"
      aria-label="Close settings"
    >&times;</button>
  </div>
  <nav class="settings-drawer__sections" aria-label="Settings sections">
    <a href="/settings/data" class="settings-drawer__section">Data</a>
    <!-- Future sections: Appearance, About -->
  </nav>
</dialog>
